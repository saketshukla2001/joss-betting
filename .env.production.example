APP_NAME=BetZone
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://joss.anekam.shop

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Shared hosting generally uses port 3306. Do not use 3307 unless MySQL
# on that server is explicitly configured to listen there.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nativefriendly_joss
DB_USERNAME=nativefriendly_joss_user
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

CRICKET_API_KEY=
CRICKET_API_BASE_URL=https://opencricketapi.com/v1/
CRICKET_API_TIMEOUT=10
